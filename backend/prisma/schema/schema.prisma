// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../client"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [citext]
}

// This replaces the old version of using environment variables for system settings
model ServerSettings {
  id                      Int                       @id @default(1)
  lastSetupVersion        String?
}

model Session {
  id                      String                    @id @default(uuid())
  userId                  String
  user                    User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash               String                    @unique // sha256
  userAgent               String?
  ip                      String?

  expiresAt               DateTime
  createdAt               DateTime                  @default(now())
}

model User {
  id                      String                    @id @default(cuid())
  email                   String                    @unique @db.Citext
  username                String                    @unique @db.Citext
  passHash                String
  sessions                Session[]
  preferences             Preferences?
  private                 Boolean                   @default(false)
  roleId                  String
  role                    Role                      @relation(fields: [roleId], references: [id])

  posts                   Post[]

  lastSeen                String?                   // pair with updatedAt
  updatedAt               DateTime                  @updatedAt
  lastLogin               DateTime                  @default(now())
  createdAt               DateTime                  @default(now())
}

model Role {
  id                      String                    @id @default(uuid())
  name                    String                    @unique
  index                   Int
  users                   User[]
  permissions             Permission[]              @relation("RolePermissions")
  color                   String
  isDefault               Boolean                   @default(false)
}

model Permission {
  name                    String                    @id @unique
  roles                   Role[]                    @relation("RolePermissions")
  createdAt               DateTime                  @default(now())
}

model Preferences {
  userId                  String                    @id
  user                    User                      @relation(fields: [userId], references: [id], onDelete: Cascade)

  blurUnsafeEmbeds        Boolean                   @default(true)
  defaultSafety           Safety                    @default(SAFE)
  // blacklistedTags
  // favoriteTags
  profileBackground       Int?                      // Post ID
}

// -------------------------------------------------------------------------------------------------------
//                                          POSTS
// -------------------------------------------------------------------------------------------------------

model Post {
  id                      Int                       @id @default(autoincrement())
  uploaderId              String
  uploader                User                      @relation(fields: [uploaderId], references: [id]) // Account deletion handles this itself
  type                    FileType
  originalPath            String
  previewPath             String?                   // If null, preview was deemed larger than original
  safety                  Safety
  sources                 String[]
  notes                   String?

  aspectRatio             Float
  fileSize                Int                       // File Size of originalPath's file in bytes
  previewSize             Int?                      // File Size of previewPath's file in bytes
  duration                Float?                    // Duration in seconds, null if TYPE is not VIDEO
  hasAudio                Boolean?                  @default(false) // Only true if TYPE is VIDEO and has an audio track

  pHash                   String
  dupeBypass              Boolean                   @default(false)

  // Relationals
  score                   Int                       @default(0) // Votes API calculates this on change
  // votes
  // comments
  // boosts
  // etc.

  updatedAt               DateTime                  @default(now()) // editing a post manually updates this
  createdAt               DateTime                  @default(now())
}