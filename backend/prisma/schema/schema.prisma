// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../client"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [citext]
}

// This replaces the old version of using environment variables for system settings
model ServerSettings {
  id                      Int                       @id @default(1)
  lastSetupVersion        String?
  convertShortVids        Boolean                   @default(true)
  boostCooldown           Int                       @default(86400) // in seconds

  featuredPostId          Int?
  featuredPost            Post?                     @relation(fields: [featuredPostId], references: [id], onDelete: SetNull)

  guestAccess             Boolean                   @default(false)
  guestSafety             Safety[]                  @default([SAFE])
}

// Works very similarly to ServerSettings, just less "core"
model Addons {
  id                      Int                       @id @default(1)

  enableAutoTagger        Boolean                   @default(false)
  autoTaggerUrl           String?
  autoTaggerMode          AutoTaggerMode[]          @default([PASSIVE])
}

model Session {
  id                      String                    @id @default(uuid())
  userId                  String
  user                    User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash               String                    @unique // sha256
  userAgent               String?
  ip                      String?

  expiresAt               DateTime
  createdAt               DateTime                  @default(now())
}

model User {
  id                      String                    @id @default(cuid())
  email                   String                    @unique @db.Citext
  username                String                    @unique @db.Citext
  passHash                String
  avatarKey               String?
  about                   String?
  sessions                Session[]
  preferences             Preferences?
  private                 Boolean                   @default(false)
  roleId                  String
  role                    Role                      @relation(fields: [roleId], references: [id])

  posts                   Post[]
  comments                PostComment[]
  postVotes               PostVote[]
  postFavorites           PostFavorite[]
  postBoosts              PostBoost[]

  poolFavorites           PoolFavorite[]

  // Dates
  lastSeen                String?                   // pair with updatedAt
  lastBoostAt             DateTime?
  updatedAt               DateTime                  @updatedAt
  lastLogin               DateTime                  @default(now())
  createdAt               DateTime                  @default(now())
}

model Role {
  id                      String                    @id @default(uuid())
  name                    String                    @unique
  index                   Int
  users                   User[]
  permissions             Permission[]              @relation("RolePermissions")
  color                   String
  isDefault               Boolean                   @default(false)
}

model Permission {
  name                    String                    @id @unique
  roles                   Role[]                    @relation("RolePermissions")
  createdAt               DateTime                  @default(now())
}

model Preferences {
  userId                  String                    @id
  user                    User                      @relation(fields: [userId], references: [id], onDelete: Cascade)

  blurUnsafeEmbeds        Boolean                   @default(true)
  defaultSafety           Safety[]                  @default([SAFE])
  // blacklistedTags
  // favoriteTags
  profileBackground       Int?                      // Post ID
}

// -------------------------------------------------------------------------------------------------------
//                                          POSTS
// -------------------------------------------------------------------------------------------------------

model Post {
  id                      Int                       @id @default(autoincrement())
  uploaderId              String
  uploader                User                      @relation(fields: [uploaderId], references: [id]) // Account deletion handles this itself
  type                    FileType
  originalPath            String
  previewPath             String?                   // If null, preview was deemed larger than original
  fileKey                 String                    @unique // The random UUID for saving filenames with
  thumbKey                String?                   // custom thumbnail's UUID key. (null = auto thumb under fileKey)
  safety                  Safety
  sources                 String[]
  notes                   String?

  aspectRatio             Float
  fileSize                BigInt                    // File Size of originalPath's file in bytes
  previewSize             BigInt?                   // File Size of previewPath's file in bytes
  duration                Float?                    // Duration in seconds, null if TYPE is not VIDEO
  hasAudio                Boolean?                  @default(false) // Only true if TYPE is VIDEO and has an audio track

  pHash                   String
  dupeBypass              Boolean                   @default(false)

  // Counts
  tagCount                Int                       @default(0) // Posts API calculates this on change
  score                   Int                       @default(0) // Votes API calculates this on change
  favoriteCount           Int                       @default(0) // Votes API calculates this on change
  boostCount              Int                       @default(0) // Votes API calculates this on change

  // Relationals
  tags                    PostTag[]
  votes                   PostVote[]
  favorites               PostFavorite[]
  comments                PostComment[]
  boosts                  PostBoost[]
  relatedFrom             PostRelation[]            @relation("RelatedFrom")
  relatedTo               PostRelation[]            @relation("RelatedTo")
  featured                ServerSettings[]          // required back-relation to server settings
  pools                   PoolPost[]
  // etc.

  updatedAt               DateTime                  @default(now()) // editing a post manually updates this
  createdAt               DateTime                  @default(now())

  @@index([score(sort: Desc), id(sort: Desc)])
  @@index([favoriteCount(sort: Desc), id(sort: Desc)])
  @@index([boostCount(sort: Desc), id(sort: Desc)])
}

model PostRelation {
  fromId                  Int
  from                    Post                      @relation("RelatedFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toId                    Int
  to                      Post                      @relation("RelatedTo", fields: [toId], references: [id], onDelete: Cascade)

  createdAt               DateTime                  @default(now())

  @@id([fromId, toId])
  @@index([toId])
}

model PostComment {
  id                      Int                       @id @default(autoincrement())
  postId                  Int
  post                    Post                      @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId                String
  author                  User                      @relation(fields: [authorId], references: [id], onDelete: Cascade)

  content                 String                    // raw text as written (after safety checks)
  editedAt                DateTime?                 // null = never edited (shown as "edited" in UI)
  createdAt               DateTime                  @default(now())

  @@index([postId, id])                             // a post's comments, paged by id
  @@index([authorId])                               // a user's comments (profile activity)
}

// Likes & Dislikes
model PostVote {
  postId                  Int
  post                    Post                      @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId                  String
  user                    User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  value                   Int                       @db.SmallInt // can only be 1 or -1

  createdAt               DateTime                  @default(now())

  @@id([postId, userId])                            // one vote per user per post
  @@index([userId])                                 // a user's votes / cascade on acc delete
}

// Favorites (duh)
model PostFavorite {
  postId                  Int
  post                    Post                      @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId                  String
  user                    User                      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt               DateTime                  @default(now())

  @@id([userId, postId])                            // one fav per post
  @@index([userId, createdAt])                      // a user's favorites, newest first
  @@index([postId])                                 // who favorited this post / cascade on post delete
}

// Boosts
model PostBoost {
  id                      Int                       @id @default(autoincrement())
  postId                  Int
  post                    Post                      @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId                  String
  user                    User                      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt               DateTime                  @default(now())

  @@index([userId, createdAt])                      // a user's history, newest first
  @@index([postId])                                 // a post's boosts / cascade on post delete
}


// -------------------------------------------------------------------------------------------------------
//                                          TAGS
// -------------------------------------------------------------------------------------------------------

model TagCategory {
  id                      Int                       @id @default(autoincrement())
  name                    String                    @unique @db.Citext
  color                   String                    // hex, e.g. "#ffffff"
  index                   Int                       @default(0)
  isDefault               Boolean                   @default(false)
  tags                    Tag[]
  flags                   CategoryFlag[]            @default([])

  updatedAt               DateTime                  @updatedAt
  createdAt               DateTime                  @default(now())
}

model Tag {
  id                      Int                       @id @default(autoincrement())
  name                    String                    @unique @db.Citext
  names                   TagName[]
  description             String?
  categoryId              Int
  category                TagCategory               @relation(fields: [categoryId], references: [id]) // category deletion handles tag migration
  flags                   TagFlag[]                 @default([])

  posts                   PostTag[]
  implications            TagImplication[]          @relation("TagImplies")     // tags this tag implies
  impliedBy               TagImplication[]          @relation("TagImpliedBy")   // tags that imply this tag
  suggestions             TagSuggestion[]           @relation("TagSuggests")
  suggestedBy             TagSuggestion[]           @relation("TagSuggestedBy")

  postCount               Int                       @default(0)

  updatedAt               DateTime                  @updatedAt
  createdAt               DateTime                  @default(now())
}

model TagName {
  name                    String                    @id @db.Citext
  tagId                   Int
  tag                     Tag                       @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@index([tagId])
}

model PostTag {
  postId                  Int
  post                    Post                      @relation(fields: [postId], references: [id], onDelete: Cascade)
  tagId                   Int
  tag                     Tag                       @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@index([tagId])
}

model TagImplication {
  tagId                   Int                       // this tag...
  tag                     Tag                       @relation("TagImplies", fields: [tagId], references: [id], onDelete: Cascade)
  impliedId               Int                       // ...implies this one
  implied                 Tag                       @relation("TagImpliedBy", fields: [impliedId], references: [id], onDelete: Cascade)

  @@id([tagId, impliedId])
  @@index([impliedId])
}

model TagSuggestion {
  tagId                   Int
  tag                     Tag                       @relation("TagSuggests", fields: [tagId], references: [id], onDelete: Cascade)
  suggestedId             Int
  suggested               Tag                       @relation("TagSuggestedBy", fields: [suggestedId], references: [id], onDelete: Cascade)

  @@id([tagId, suggestedId])
  @@index([suggestedId])
}


// -------------------------------------------------------------------------------------------------------
//                                              POOLS
// -------------------------------------------------------------------------------------------------------

model Pool {
  id                      Int                       @id @default(autoincrement())
  name                    String                    @db.Citext
  description             String?
  yearStart               Int?
  yearEnd                 Int?
  favoriteCount           Int                       @default(0) // Favorites API calcs this on change

  items                   PoolPost[]
  favorites               PoolFavorite[]

  updatedAt               DateTime                  @default(now()) // API updates automatically
  createdAt               DateTime                  @default(now())
}

model PoolPost {
  poolId                  Int
  pool                    Pool                      @relation(fields: [poolId], references: [id], onDelete: Cascade)
  postId                  Int
  post                    Post                      @relation(fields: [postId], references: [id], onDelete: Cascade)
  index                   Int

  @@id([poolId, postId])                            // a post appears once per pool
  @@unique([poolId, index])                         // also serves as the ordered-read index
  @@index([postId])                                 // "which pools is this post in" + delete cascade
}

model PoolFavorite {
  poolId                  Int
  pool                    Pool                      @relation(fields: [poolId], references: [id], onDelete: Cascade)
  userId                  String
  user                    User                      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt               DateTime                  @default(now())

  @@id([userId, poolId])                            // one fav per pool
  @@index([userId, createdAt])                      // a user's favorite pools, newest first
  @@index([poolId])                                 // cascade on pool delete
}