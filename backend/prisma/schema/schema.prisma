// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../client"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [citext]
}

// This replaces the old version of using environment variables for system settings
model ServerSettings {
  id                      Int                       @id @default(1)
  lastSetupVersion        String?
  convertShortVids        Boolean                   @default(true)

  featuredPostId          Int?
  featuredPost            Post?                     @relation(fields: [featuredPostId], references: [id], onDelete: SetNull)

  guestAccess             Boolean                   @default(false)
  guestSafety             Safety[]                  @default([SAFE])
}

model Session {
  id                      String                    @id @default(uuid())
  userId                  String
  user                    User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash               String                    @unique // sha256
  userAgent               String?
  ip                      String?

  expiresAt               DateTime
  createdAt               DateTime                  @default(now())
}

model User {
  id                      String                    @id @default(cuid())
  email                   String                    @unique @db.Citext
  username                String                    @unique @db.Citext
  passHash                String
  avatarKey               String?
  about                   String?
  sessions                Session[]
  preferences             Preferences?
  private                 Boolean                   @default(false)
  roleId                  String
  role                    Role                      @relation(fields: [roleId], references: [id])

  posts                   Post[]
  comments                PostComment[]

  lastSeen                String?                   // pair with updatedAt
  updatedAt               DateTime                  @updatedAt
  lastLogin               DateTime                  @default(now())
  createdAt               DateTime                  @default(now())
}

model Role {
  id                      String                    @id @default(uuid())
  name                    String                    @unique
  index                   Int
  users                   User[]
  permissions             Permission[]              @relation("RolePermissions")
  color                   String
  isDefault               Boolean                   @default(false)
}

model Permission {
  name                    String                    @id @unique
  roles                   Role[]                    @relation("RolePermissions")
  createdAt               DateTime                  @default(now())
}

model Preferences {
  userId                  String                    @id
  user                    User                      @relation(fields: [userId], references: [id], onDelete: Cascade)

  blurUnsafeEmbeds        Boolean                   @default(true)
  defaultSafety           Safety[]                  @default([SAFE])
  // blacklistedTags
  // favoriteTags
  profileBackground       Int?                      // Post ID
}

// -------------------------------------------------------------------------------------------------------
//                                          POSTS
// -------------------------------------------------------------------------------------------------------

model Post {
  id                      Int                       @id @default(autoincrement())
  uploaderId              String
  uploader                User                      @relation(fields: [uploaderId], references: [id]) // Account deletion handles this itself
  type                    FileType
  originalPath            String
  previewPath             String?                   // If null, preview was deemed larger than original
  fileKey                 String                    @unique // The random UUID for saving filenames with
  thumbKey                String?                   // custom thumbnail's UUID key. (null = auto thumb under fileKey)
  safety                  Safety
  sources                 String[]
  notes                   String?

  aspectRatio             Float
  fileSize                BigInt                    // File Size of originalPath's file in bytes
  previewSize             BigInt?                   // File Size of previewPath's file in bytes
  duration                Float?                    // Duration in seconds, null if TYPE is not VIDEO
  hasAudio                Boolean?                  @default(false) // Only true if TYPE is VIDEO and has an audio track

  pHash                   String
  dupeBypass              Boolean                   @default(false)

  // Relationals
  tags                    PostTag[]
  tagCount                Int                       @default(0) // Posts API calculates this on change
  score                   Int                       @default(0) // Votes API calculates this on change
  // votes
  comments                PostComment[]
  // boosts
  relatedFrom             PostRelation[]            @relation("RelatedFrom")
  relatedTo               PostRelation[]            @relation("RelatedTo")
  featured                ServerSettings[]          // required back-relation to server settings
  // etc.

  updatedAt               DateTime                  @default(now()) // editing a post manually updates this
  createdAt               DateTime                  @default(now())
}

model PostRelation {
  fromId                  Int
  from                    Post                      @relation("RelatedFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toId                    Int
  to                      Post                      @relation("RelatedTo", fields: [toId], references: [id], onDelete: Cascade)

  createdAt               DateTime                  @default(now())

  @@id([fromId, toId])
  @@index([toId])
}

model PostComment {
  id                      Int                       @id @default(autoincrement())
  postId                  Int
  post                    Post                      @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId                String
  author                  User                      @relation(fields: [authorId], references: [id], onDelete: Cascade)

  content                 String                    // raw text as written (after safety checks)
  editedAt                DateTime?                 // null = never edited (shown as "edited" in UI)
  createdAt               DateTime                  @default(now())

  @@index([postId, id])                             // a post's comments, paged by id
  @@index([authorId])                               // a user's comments (profile activity)
}


// -------------------------------------------------------------------------------------------------------
//                                          TAGS
// -------------------------------------------------------------------------------------------------------

model TagCategory {
  id                      Int                       @id @default(autoincrement())
  name                    String                    @unique @db.Citext
  color                   String                    // hex, e.g. "#ffffff"
  index                   Int                       @default(0)
  isDefault               Boolean                   @default(false)
  tags                    Tag[]

  updatedAt               DateTime                  @updatedAt
  createdAt               DateTime                  @default(now())
}

model Tag {
  id                      Int                       @id @default(autoincrement())
  name                    String                    @unique @db.Citext
  names                   TagName[]
  description             String?
  categoryId              Int
  category                TagCategory               @relation(fields: [categoryId], references: [id]) // category deletion handles tag migration
  flags                   TagFlag[]                 @default([])

  posts                   PostTag[]
  implications            TagImplication[]          @relation("TagImplies")     // tags this tag implies
  impliedBy               TagImplication[]          @relation("TagImpliedBy")   // tags that imply this tag
  suggestions             TagSuggestion[]           @relation("TagSuggests")
  suggestedBy             TagSuggestion[]           @relation("TagSuggestedBy")

  postCount               Int                       @default(0)

  updatedAt               DateTime                  @updatedAt
  createdAt               DateTime                  @default(now())
}

model TagName {
  name                    String                    @id @db.Citext
  tagId                   Int
  tag                     Tag                       @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@index([tagId])
}

model PostTag {
  postId                  Int
  post                    Post                      @relation(fields: [postId], references: [id], onDelete: Cascade)
  tagId                   Int
  tag                     Tag                       @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@index([tagId])
}

model TagImplication {
  tagId                   Int                       // this tag...
  tag                     Tag                       @relation("TagImplies", fields: [tagId], references: [id], onDelete: Cascade)
  impliedId               Int                       // ...implies this one
  implied                 Tag                       @relation("TagImpliedBy", fields: [impliedId], references: [id], onDelete: Cascade)

  @@id([tagId, impliedId])
  @@index([impliedId])
}

model TagSuggestion {
  tagId                   Int
  tag                     Tag                       @relation("TagSuggests", fields: [tagId], references: [id], onDelete: Cascade)
  suggestedId             Int
  suggested               Tag                       @relation("TagSuggestedBy", fields: [suggestedId], references: [id], onDelete: Cascade)

  @@id([tagId, suggestedId])
  @@index([suggestedId])
}