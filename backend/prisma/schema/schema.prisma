// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// This replaces the old version of using environment variables for system settings
// Each line has its own unique ID for the setting rather than each setting being a column of 1 line
// IDs should be all UPPERCASE with UNDERSCORES instead of spaces
model ServerSetting {
  id                      String                    @id @unique // "e.g. SITE_TITLE"
}

model Session {
  id                      String                    @id @default(uuid())
  userId                  String
  user                    User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash               String                    @unique // sha256
  userAgent               String?
  ip                      String?

  expiresAt               DateTime
  createdAt               DateTime                  @default(now())
}

model User {
  id                      String                    @id @default(cuid())
  email                   String                    @unique
  username                String                    @unique
  passHash                String
  sessions                Session[]

  roleId                  Int
  role                    Role                      @relation(fields: [roleId], references: [id])

  lastLogin               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  createdAt               DateTime                  @default(now())
}

model Role {
  id                      Int                       @id @default(autoincrement())
  name                    String                    @unique
  index                   Int
  users                   User[]
  permissions             Permission[]              @relation("RolePermissions")
  color                   String
  isDefault               Boolean                   @default(false)
}

model Permission {
  name                    String                    @id @unique
  description             String?

  roles                   Role[]                    @relation("RolePermissions")
  createdAt               DateTime                  @default(now())
}