// For all the custon enums to go, for organization sake lol

enum Safety {
  SAFE
  QUESTIONABLE
  EXPLICIT
}

enum FileType {
  IMAGE      // png, jpg, webp, etc.
  ANIMATED   // gif, animated png, animated webp, etc.
  VIDEO      // mp4, mkv, webm, mov, etc.
}

enum TagFlag {
  REACTION    // Reaction images / GIFs for comments
}

enum AutoTaggerMode {
  PASSIVE
  AGGRESSIVE
  SELECTIVE
}

// So we can treat popular categories the same, even if their name is a little different
enum CategoryFlag {
  CREATOR     // e.g. "Artists"
  SUBJECT     // e.g. "Characters"
}