DATABASE_URL="postgresql://user:password@localhost:5432/bpnew"

# VERBOSE, DEBUG, INFO, WARN, or ERROR. VERBOSE is for development only.
LOG_LEVEL=INFO

# Set to DEVELOPMENT when running locally over http://.
# Anything else (or unset) is treated as production: cookies require HTTPS.
# MODE=DEVELOPMENT

# Unless you plan on running multiple instances on the same machine, you should leave this alone.
API_PORT=3070

# The URL users visit your booru at. Used for CORS: only this origin may make logged-in requests.
# Must share a domain with the API (e.g. booru.example.com + api.booru.example.com,
# or the API behind a reverse proxy at booru.example.com/api), or login cookies won't work.
FRONTEND_URL=https://example.booru.party

# Signs login tokens. Anyone with this can log in as any user: keep it secret, never reuse it.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="" # SET ME

# Reverse proxies allowed to report the real client IP (X-Forwarded-For).
# Localhost is always trusted (local nginx, cloudflared).
# Add more as a comma-separated list of IPs or CIDR ranges, not domains.
#
# Docker example: TRUSTED_PROXIES=172.18.0.0/16
# Never expose API_PORT directly to the internet; only through your proxy.
# TRUSTED_PROXIES=
